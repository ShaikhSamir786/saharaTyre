{
  "rewrites": [
    { "source": "/", "destination": "/index.htm" },
    { "source": "/services", "destination": "/services/index.htm" },
    { "source": "/services/", "destination": "/services/index.htm" },
    { "source": "/services/:slug", "destination": "/services/:slug.htm" },
    { "source": "/brands", "destination": "/brands/index.htm" },
    { "source": "/brands/", "destination": "/brands/index.htm" },
    { "source": "/brands/:slug", "destination": "/brands/:slug.htm" },
    { "source": "/locations", "destination": "/locations/index.htm" },
    { "source": "/locations/", "destination": "/locations/index.htm" },
    { "source": "/locations/:slug", "destination": "/locations/:slug.htm" },
    { "source": "/blog", "destination": "/blog/index.htm" },
    { "source": "/blog/", "destination": "/blog/index.htm" },
    { "source": "/blog/:slug", "destination": "/blog/:slug.htm" },
    { "source": "/vehicles", "destination": "/vehicles/index.htm" },
    { "source": "/vehicles/", "destination": "/vehicles/index.htm" },
    { "source": "/vehicles/:slug", "destination": "/vehicles/:slug.htm" },
    { "source": "/tyres/:slug", "destination": "/tyres/:slug.htm" },
    { "source": "/truck-tyres/:slug", "destination": "/truck-tyres/:slug.htm" },
    { "source": "/products", "destination": "/products.htm" },
    { "source": "/location", "destination": "/location.htm" },
    { "source": "/contact", "destination": "/location.htm" },
    { "source": "/about", "destination": "/about.htm" },
    { "source": "/truck-tyres", "destination": "/vehicles/truck-tyres.htm" },
    { "source": "/bus-tyres", "destination": "/vehicles/bus-tyres.htm" },
    { "source": "/car-tyres", "destination": "/vehicles/car-tyres.htm" },
    { "source": "/bike-tyres", "destination": "/vehicles/bike-tyres.htm" },
    { "source": "/scooter-tyres", "destination": "/vehicles/scooter-tyres.htm" },
    { "source": "/commercial-vehicle-tyres", "destination": "/vehicles/commercial-vehicle-tyres.htm" },
    { "source": "/crane-tyres", "destination": "/vehicles/crane-tyres.htm" },
    { "source": "/tractor-tyres", "destination": "/vehicles/tractor-tyres.htm" },
    { "source": "/agricultural-tyres", "destination": "/vehicles/agricultural-tyres.htm" },
    { "source": "/otr-earthmover-tyres", "destination": "/vehicles/otr-earthmover-tyres.htm" },
    { "source": "/industrial-tyres", "destination": "/vehicles/industrial-tyres.htm" },
    { "source": "/new-tyres", "destination": "/new-tyres.htm" },
    { "source": "/used-tyres", "destination": "/used-tyres.htm" },
    { "source": "/remould-tyres", "destination": "/remould-tyres.htm" },
    { "source": "/new-vs-used-tyres", "destination": "/new-vs-used-tyres.htm" },
    { "source": "/new-vs-remould-tyres", "destination": "/new-vs-remould-tyres.htm" },
    { "source": "/used-vs-remould-tyres", "destination": "/used-vs-remould-tyres.htm" },
    { "source": "/privacy", "destination": "/privacy.htm" },
    { "source": "/terms", "destination": "/terms.htm" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(self)" },
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/index.htm",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/(llms.txt|llms-full.txt|ai.txt|humans.txt)",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/.well-known/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
